<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The only permission. Notification access is granted by the user in Settings. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Cleartext allowed so the test receiver can run over plain http on the LAN. -->
    <application
        android:label="IG Notify Forwarder"
        android:theme="@android:style/Theme.Material.Light"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Only the system holds BIND_NOTIFICATION_LISTENER_SERVICE, so exported is safe. -->
        <service
            android:name=".IgListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
